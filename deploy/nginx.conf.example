# Replace domain/certificate paths with your server's actual HTTPS settings.
server {
    listen 80;
    server_name avagroups.ir;
    return 301 https://avagroups.ir$request_uri;
}
server {
    listen 443 ssl;
    server_name avagroups.ir;
    ssl_certificate /etc/letsencrypt/live/avagroups.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/avagroups.ir/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 48m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
